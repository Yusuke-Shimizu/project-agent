# Secrets (local environment files are never committed)
.env.local

# CDK Build Artifacts
cdk/cdk.out/
cdk/node_modules/

# CLI Internals
.cli/*

# Ephemeral Staging
.cache/*

# Exception: Commit the State
!.cli/deployed-state.json

# デプロイ先（アカウント ID が入る）。public リポジトリなのでコミットしない。
# aws-targets.json.example をコピーして自分のアカウントを書く。
aws-targets.json
